{
  "name": "ai-job-aggregation-career-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "India-first AI-powered job aggregation and career assistant platform.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "pnpm --filter @ai-job-platform/api dev",
    "api:start": "pnpm --filter @ai-job-platform/api start",
    "api:typecheck": "pnpm --filter @ai-job-platform/api typecheck",
    "web:dev": "pnpm --filter @ai-job-platform/web dev",
    "web:build": "pnpm --filter @ai-job-platform/web build",
    "web:typecheck": "pnpm --filter @ai-job-platform/web typecheck",
    "worker:dev": "pnpm --filter @ai-job-platform/worker dev",
    "worker:start": "pnpm --filter @ai-job-platform/worker start",
    "worker:ingest:once": "pnpm --filter @ai-job-platform/worker ingest:once",
    "worker:typecheck": "pnpm --filter @ai-job-platform/worker typecheck",
    "database:typecheck": "pnpm --filter @ai-job-platform/database typecheck",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "ingestion:typecheck": "tsc --noEmit -p packages/ingestion/tsconfig.json",
    "typecheck": "pnpm database:typecheck && pnpm api:typecheck && pnpm worker:typecheck && pnpm ingestion:typecheck && pnpm web:typecheck"
  },
  "devDependencies": {
    "prisma": "^6.13.0",
    "typescript": "^5.9.2"
  }
}
