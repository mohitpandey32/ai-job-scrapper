# Application
NODE_ENV=development
APP_NAME=ai-job-aggregation-career-assistant
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=

# Database - pending Phase 3 approval
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_jobs

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_TOKEN_SECRET=replace-with-local-32-plus-character-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-different-local-32-plus-character-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=

# Search
SEARCH_PROVIDER=postgres
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
OPENSEARCH_URL=
