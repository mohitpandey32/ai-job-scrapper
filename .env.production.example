# Production template. Do not commit real secret values.

# Application
NODE_ENV=production
APP_NAME=ai-job-aggregation-career-assistant
APP_URL=https://your-frontend-domain.com
API_URL=https://your-api-service.onrender.com
CORS_ORIGIN=https://your-frontend-domain.com
COOKIE_DOMAIN=

# Frontend build
VITE_API_URL=https://your-api-service.onrender.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Redis
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Authentication
JWT_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_TOKEN_SECRET=replace-with-a-different-32-plus-character-secret

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=

# Object Storage - future production resume storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ENDPOINT=
